{
  "name": "limpador-usb",
  "productName": "LimpadorUSB",
  "version": "1.0.0",
  "description": "Limpador USB de Impressoras - ferramenta do tecnico para liberar portas USB virtuais antes de resetar impressoras.",
  "author": "DLTechSup",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "cli": "node electron/cli-teste.cjs",
    "dist": "vite build && electron-builder --win portable --x64 --ia32 --publish never"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.11",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "br.com.dltechsup.limpadorusb",
    "productName": "LimpadorUSB",
    "copyright": "DLTechSup",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "LimpadorUSB-${arch}.exe",
      "requestExecutionLevel": "admin"
    }
  }
}
