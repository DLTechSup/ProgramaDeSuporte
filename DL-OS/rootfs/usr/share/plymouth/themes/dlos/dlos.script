# DL OS - tela de boot animada (deriva, brilho, feixe de luz, faíscas, barra, log)
W = Window.GetWidth(); H = Window.GetHeight();
Window.SetBackgroundTopColor(0.016, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.016, 0.04, 0.09);

# fundo 4% maior que a tela: permite a deriva lenta (parallax) sem reescalar a cada quadro
bg = Image("bg.png");
r = Math.Max(W / bg.GetWidth(), H / bg.GetHeight()) * 1.04;
bw0 = bg.GetWidth() * r; bh0 = bg.GetHeight() * r;
bgs = Sprite(bg.Scale(bw0, bh0)); bgs.SetZ(-10);
ox = (W - bw0) / 2; oy = (H - bh0) / 2;

# centro do logo DL na arte (fração da imagem)
lx = ox + bw0 * 0.503; ly = oy + bh0 * 0.34;
glow_img = Image("glow.png"); gs = Math.Min(W, H) * 0.55;
glow = Sprite(glow_img.Scale(gs, gs)); glow.SetZ(-5);
sweep_img = Image("sweep.png"); sweep = Sprite(sweep_img.Scale(W * 0.12, H * 1.1)); sweep.SetZ(-4);

# faíscas
NS = 22; spark_img = Image("spark.png"); sp = [];
for (i = 0; i < NS; i++) { sp[i] = Sprite(spark_img.Scale(8 + (i % 3) * 4, 8 + (i % 3) * 4)); sp[i].SetZ(-3); }

# barra de progresso
bw = W * 0.36; bh = 8; bx = (W - bw) / 2; by = H * 0.955;
track = Sprite(Image("bar-track.png").Scale(bw, bh)); track.SetPosition(bx, by, 5);
fillimg = Image("bar-fill.png"); fill = Sprite(); fill.SetPosition(bx, by, 6);

# linhas de log (estilo terminal)
lines = ["KERNEL CORE", "LOGIC PATHWAYS", "REGISTERS", "FILE SYSTEM", "HARDWARE", "GRAPHICS..."];
NL = 6; ls = [];
for (i = 0; i < NL; i++) { ls[i] = Sprite(); ls[i].SetPosition(W * 0.04, H * 0.70 + i * (H * 0.04), 8); }

t = 0; prog = 0;
fun boot_cb(time, p) { prog = p; }
Plymouth.SetBootProgressFunction(boot_cb);

fun frac(x) { return x - Math.Int(x); }

fun refresh() {
  t += 0.03;
  # deriva suave do fundo
  bgs.SetPosition(ox + Math.Sin(t * 0.35) * (bw0 - W) / 2, oy + Math.Cos(t * 0.27) * (bh0 - H) / 2, -10);
  # logo "respirando"
  glow.SetPosition(lx - gs / 2, ly - gs / 2, -5);
  glow.SetOpacity(0.30 + 0.25 * Math.Sin(t * 2.2));
  # feixe de luz a cada ~5s
  ph = frac(t / 5);
  sweep.SetPosition(-W * 0.2 + ph * W * 1.4, -H * 0.05, -4);
  sweep.SetOpacity(0.7 * Math.Sin(ph * 3.1416));
  # faíscas subindo
  for (i = 0; i < NS; i++) {
    seed = frac(Math.Sin(i * 12.9898) * 43758.5453);
    sp_t = frac(t * (0.05 + seed * 0.06) + seed);
    sp[i].SetPosition(W * (0.05 + 0.9 * frac(seed * 7.3)) + Math.Sin(t + i) * 12, H * (1.0 - sp_t * 1.05), -3);
    sp[i].SetOpacity(Math.Sin(sp_t * 3.1416) * 0.9);
  }
  # barra: progresso real do boot, ou estimado se o sistema não informar
  p = t / (t + 8); if (prog > p) p = prog; if (p < 0.02) p = 0.02;
  fill.SetImage(fillimg.Scale(bw * p, bh));
  # log: uma linha nova a cada ~1,3s
  n = Math.Int(t / 1.3) + 1; if (n > NL) n = NL;
  for (i = 0; i < n; i++) {
    if (i < NL - 1 || t / 1.3 > NL) tag = "[  OK  ] "; else tag = "[ BUSY ] ";
    if (i == n - 1 && n == NL) tag = "[ BUSY ] ";
    if (tag == "[  OK  ] ") ls[i].SetImage(Image.Text(tag + lines[i], 0.45, 1.0, 0.65, 1, "Mono 11"));
    else ls[i].SetImage(Image.Text(tag + lines[i], 1.0, 0.95, 0.3, 1, "Mono 11"));
  }
}
Plymouth.SetRefreshFunction(refresh);
