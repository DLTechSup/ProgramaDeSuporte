# DL OS - tela de boot: imagem oficial + barra de progresso
W = Window.GetWidth(); H = Window.GetHeight();
Window.SetBackgroundTopColor(0.016, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.016, 0.04, 0.09);
bg = Image("bg.png");
r = Math.Min(W / bg.GetWidth(), H / bg.GetHeight());
bgi = bg.Scale(bg.GetWidth() * r, bg.GetHeight() * r);
bgs = Sprite(bgi); bgs.SetX((W - bgi.GetWidth()) / 2); bgs.SetY((H - bgi.GetHeight()) / 2);
bw = W * 0.30; bh = 6; bx = (W - bw) / 2; by = H * 0.94;
track = Sprite(Image("bar-track.png").Scale(bw, bh)); track.SetPosition(bx, by, 5);
fillimg = Image("bar-fill.png"); fill = Sprite(); fill.SetPosition(bx, by, 6);
t = 0; prog = 0;
fun boot_cb(time, p) { prog = p; }
Plymouth.SetBootProgressFunction(boot_cb);
fun refresh() { t += 0.03; p = t / (t + 8); if (prog > p) p = prog; fill.SetImage(fillimg.Scale(bw * p, bh)); }
Plymouth.SetRefreshFunction(refresh);
