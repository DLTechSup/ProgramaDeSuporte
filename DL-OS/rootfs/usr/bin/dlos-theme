#!/usr/bin/env bash
# dlos-theme list | apply <id> | current
D=/usr/share/dlos/themes
case "${1:-}" in
  list) for t in "$D"/DLOS-*; do basename "$t" | sed 's/DLOS-//'; done ;;
  current) xfconf-query -c xsettings -p /Net/ThemeName ;;
  apply) id="${2:?id do tema}"; [ -d "$D/DLOS-$id" ] || { echo "tema inexistente"; exit 1; }
    mkdir -p ~/.themes ~/.config/kitty
    cp -r "$D/DLOS-$id" ~/.themes/
    xfconf-query -c xsettings -p /Net/ThemeName -s "DLOS-$id" --create -t string
    xfconf-query -c xsettings -p /Net/IconThemeName -s Papirus-Dark --create -t string
    cp "$D/DLOS-$id/kitty.conf" ~/.config/kitty/theme.conf
    for m in $(xfconf-query -c xfce4-desktop -l | grep last-image); do
      xfconf-query -c xfce4-desktop -p "$m" -s "$D/DLOS-$id/wallpaper.svg"; done
    echo "Tema '$id' aplicado." ;;
  *) sed -n '2p' "$0"; exit 1 ;;
esac
