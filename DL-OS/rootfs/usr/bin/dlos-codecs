#!/usr/bin/env bash
# Verifica se os codecs/containers essenciais estão disponíveis no ffmpeg/mpv.
V="h264 hevc av1 vp8 vp9 mpeg2video mpeg4 wmv3 vc1 prores theora mjpeg"
A="aac ac3 eac3 dts truehd mp3 flac alac opus vorbis wmav2 ape wavpack tta pcm_s16le dsd_lsbf amrnb"
C="matroska mp4 avi mov flv webm mpegts asf ogg wav flac ape ac3 dts aiff"
ok=0; bad=0
for k in "decoders:$V $A" "demuxers:$C"; do kind=${k%%:*}; for n in ${k#*:}; do
  if ffmpeg -hide_banner -${kind} 2>/dev/null | awk '{print $2}' | grep -qx "$n"; then ok=$((ok+1)); else echo "FALTA ($kind): $n"; bad=$((bad+1)); fi
done; done
echo "OK: $ok  | Faltando: $bad"; [ $bad -eq 0 ]
