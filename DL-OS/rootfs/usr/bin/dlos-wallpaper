#!/usr/bin/env bash
# dlos-wallpaper on | off | status : papel de parede animado (loop de vídeo). Usa um pouco de CPU/GPU.
V=/usr/share/dlos/branding/wallpaper-animado.mp4
case "${1:-status}" in
  on)  pkill -f 'mpv.*dlos-wallpaper' 2>/dev/null; xfdesktop --quit 2>/dev/null; sleep 0.5
       ROOT=$(xwininfo -root | awk '/Window id/{print $4}')
       nohup nice -n 15 mpv --title=dlos-wallpaper --wid="$ROOT" --loop-file=inf --no-audio --no-osc --no-input-default-bindings \
         --hwdec=auto-safe --panscan=1 --really-quiet "$V" >/dev/null 2>&1 &
       mkdir -p ~/.config/dlos && touch ~/.config/dlos/animated-wallpaper; echo "animado: ligado" ;;
  off) pkill -f 'mpv.*dlos-wallpaper'; rm -f ~/.config/dlos/animated-wallpaper; (xfdesktop &) >/dev/null 2>&1; echo "animado: desligado" ;;
  *)   pgrep -f 'mpv.*dlos-wallpaper' >/dev/null && echo ligado || echo desligado ;;
esac
