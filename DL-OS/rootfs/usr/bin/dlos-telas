#!/usr/bin/env bash
# dlos-telas [estender|espelhar|so <saida>|gui|salvar|status] : várias telas (monitor + TV).
# Ao conectar/desconectar uma tela, o autorandr aplica o perfil salvo para aquela combinação.
mapfile -t OUT < <(xrandr | awk '/ connected/{print $1}')
case "${1:-estender}" in
  status) xrandr | grep -E " connected|\*" ;;
  gui) exec xfce4-display-settings ;;
  salvar) autorandr --save "${2:-trabalho}" && echo "layout salvo (reaplica sozinho quando essas telas forem conectadas)" ;;
  espelhar) a=${OUT[0]}; args=(--output "$a" --auto --primary)
            for o in "${OUT[@]:1}"; do args+=(--output "$o" --auto --same-as "$a"); done; xrandr "${args[@]}" ;;
  so) for o in "${OUT[@]}"; do [ "$o" = "$2" ] && xrandr --output "$o" --auto --primary || xrandr --output "$o" --off; done ;;
  estender) prev=""; for o in "${OUT[@]}"; do
              if [ -z "$prev" ]; then xrandr --output "$o" --auto --primary; else xrandr --output "$o" --auto --right-of "$prev"; fi
              prev=$o; done; echo "telas estendidas: ${OUT[*]}" ;;
  *) sed -n '2,3p' "$0" ;;
esac
