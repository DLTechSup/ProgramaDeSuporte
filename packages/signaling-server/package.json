{
  "name": "@nexodesk/signaling-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de sinalizacao do NexoDesk: apenas descoberta de ID e relay de handshake WebRTC. Nunca ve tela, teclado, arquivos ou senhas.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexodesk/shared": "0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12"
  }
}
