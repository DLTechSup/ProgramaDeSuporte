{
  "name": "@nexodesk/client-agent",
  "version": "0.1.0",
  "private": true,
  "description": "NexoDesk Agent - aplicativo instalado no computador do cliente para receber suporte remoto.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@nexodesk/shared": "0.1.0",
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10"
  }
}
