{
  "name": "nexodesk",
  "private": true,
  "version": "0.1.0",
  "description": "NexoDesk - software de acesso remoto seguro (host + controlador + servidor de sinalizacao + servidor de licencas)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:signaling": "npm run dev --workspace packages/signaling-server",
    "dev:license": "npm run dev --workspace packages/license-server"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
